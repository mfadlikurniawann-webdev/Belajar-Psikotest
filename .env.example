# Salin menjadi `.env` di ROOT monorepo untuk development lokal:  cp .env.example .env
# Di Vercel, isi variabel yang sama lewat Project Settings > Environment Variables.

# ---------------------------------------------------------------------------
# Database (PostgreSQL) - pilih Neon ATAU Supabase
# ---------------------------------------------------------------------------
# Neon     : pakai connection string "Pooled" (host mengandung "-pooler"), tambahkan ?sslmode=require
#            postgres://USER:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Supabase : pakai "Transaction pooler" (port 6543)
#            postgres://postgres.PROJECT_REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Opsional: koneksi langsung (non-pooled) khusus untuk migrasi (drizzle-kit).
# Neon: URL tanpa "-pooler". Supabase: "Session pooler" (port 5432) atau direct connection.
DIRECT_DATABASE_URL=

# ---------------------------------------------------------------------------
# Aplikasi
# ---------------------------------------------------------------------------
# URL publik untuk tautan di email. Di Vercel boleh dikosongkan (otomatis dari domain production).
APP_URL=http://localhost:3000

# Wajibkan verifikasi email sebelum peserta bisa memulai tes (true/false).
REQUIRE_EMAIL_VERIFICATION=false

# ---------------------------------------------------------------------------
# Email (Resend) - kosongkan RESEND_API_KEY saat development: email dicetak ke terminal.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Harus memakai domain yang sudah diverifikasi di Resend (onboarding@resend.dev hanya untuk uji coba).
EMAIL_FROM=Belajar Psikotest <onboarding@resend.dev>
# Email superadmin yang dinotifikasi saat peserta menyelesaikan semua tes (pisahkan dengan koma).
ADMIN_NOTIFY_EMAIL=

# ---------------------------------------------------------------------------
# Akun superadmin (dipakai oleh `pnpm db:seed`)
# ---------------------------------------------------------------------------
SUPERADMIN_EMAIL=admin@contoh.id
SUPERADMIN_PASSWORD=ganti-dengan-password-kuat
SUPERADMIN_NAME=Super Admin
